{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/tsconfig.json",
    "packages/rrweb-player/.svelte-kit/**",
    "**/test/html/**",
    "**/test/iframe-html/**",
    "**/test/css/**",
    "**/__snapshots__/**",
    "**/__image_snapshots__/**",
    "CHANGELOG.md",
    "**/CHANGELOG.md"
  ]
}
