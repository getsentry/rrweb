{
  "name": "@rrweb/_monorepo",
  "description": "record and replay the web",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/rrweb-io/rrweb.git"
  },
  "keywords": [
    "rrweb"
  ],
  "author": "yanzhen@smartx.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rrweb-io/rrweb/issues"
  },
  "private": true,
  "homepage": "https://github.com/rrweb-io/rrweb#readme",
  "workspaces": [
    "packages/*",
    "packages/plugins/*"
  ],
  "devDependencies": {
    "@monorepo-utils/workspaces-to-typescript-project-references": "^2.10.2",
    "@size-limit/preset-small-lib": "~11.2.0",
    "@size-limit/webpack": "~11.2.0",
    "@types/dom-mediacapture-transform": "0.1.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/offscreencanvas": "^2019.6.4",
    "@types/prettier": "2.7.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "browserslist": "^4.22.1",
    "concurrently": "^9.0.0",
    "esbuild": "^0.25.0",
    "esbuild-plugin-umd-wrapper": "^2.0.0",
    "eslint": "^8.53.0",
    "eslint-plugin-compat": "^4.2.0",
    "eslint-plugin-jest": "^27.6.0",
    "eslint-plugin-tsdoc": "^0.2.17",
    "fast-glob": "^3.2.9",
    "jsdom": "^25.0.0",
    "markdownlint": "^0.40.0",
    "markdownlint-cli": "^0.48.0",
    "prettier": "2.8.4",
    "size-limit": "~11.2.0",
    "turbo": "^2.0.3",
    "typescript": "^4.9.5",
    "vite": "^6.4.4",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.6"
  },
  "scripts": {
    "build:all": "NODE_OPTIONS='--max-old-space-size=4096' pnpm exec concurrently --success=all -r -m=1 'pnpm exec workspaces-to-typescript-project-references' 'pnpm exec turbo run prepack'",
    "build:tarball": "pnpm exec turbo run build:tarball",
    "test": "pnpm exec concurrently --success=all -r -m=1 'pnpm exec workspaces-to-typescript-project-references --check' 'pnpm exec turbo run test --concurrency=1 --continue'",
    "test:watch": "pnpm exec turbo run test:watch",
    "test:update": "pnpm exec turbo run test:update",
    "check-types": "pnpm exec turbo run check-types --continue",
    "format": "pnpm exec prettier --write '**/*.{ts,md}'",
    "format:head": "git diff --name-only HEAD^ |grep '\\.ts$\\|\\.md$' |xargs pnpm exec prettier --write",
    "dev": "CLEAR_DIST_DIR=false pnpm exec turbo run dev --concurrency=17",
    "repl": "cd packages/rrweb && npm run repl",
    "live-stream": "cd packages/rrweb && pnpm run live-stream",
    "lint": "pnpm exec concurrently --success=all -r -m=1 'pnpm exec markdownlint docs' 'pnpm exec eslint packages/*/src --ext .ts,.tsx,.js,.jsx,.svelte'",
    "lint:report": "pnpm exec eslint --output-file eslint_report.json --format json packages/*/src --ext .ts,.tsx,.js,.jsx",
    "dedupe-deps:check": "pnpm dedupe --check",
    "dedupe-deps:fix": "pnpm dedupe"
  },
  "browserslist": [
    "defaults",
    "not op_mini all"
  ],
  "packageManager": "pnpm@12.11.2",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.4",
      "onFail": "warn"
    }
  }
}
